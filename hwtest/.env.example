# Copy to hwtest/.env (gitignored). Never commit the real file.

# --- Stage 1 (ping_pong.py): no key strictly required ---------------------------
# Wake/command phrases are synthesized with macOS `say -v Milena` by default and
# transcribed with a local faster-whisper model. Optional upgrades below.

# ElevenLabs — optional, only for `--tts elevenlabs` (nicer / different voices for
# the test phrases; results cached in hwtest/cache/).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=cjVigY5qzO86Huf0OWal

# --- Stage 2 (realtime_openai.py): bidirectional realtime talk with OpenAI -------
# https://developers.openai.com/api/docs/guides/realtime
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# --- Device ----------------------------------------------------------------------
# USB serial of the Voice PE (ESP32-S3 "USB JTAG_serial debug unit"). Auto-detected
# as /dev/cu.usbmodem* when empty. Set to "off" to disable log capture.
VOICE_PE_SERIAL=
VOICE_PE_HOST=192.168.68.83

# Audio device names/indices for sounddevice (see `python ping_pong.py --list-devices`).
# Empty = system default.
HWTEST_INPUT_DEVICE=
HWTEST_OUTPUT_DEVICE=
