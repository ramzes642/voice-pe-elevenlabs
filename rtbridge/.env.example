# rtbridge — runs on the Raspberry Pi. Copy to rtbridge/.env (gitignored).
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Voice PE native API. PSK = the api.encryption.key of the device. Either set it here or
# point VOICE_PE_YAML at the ESPHome config the device was built from (it is read at startup).
VOICE_PE_HOST=192.168.68.83
VOICE_PE_PSK=
VOICE_PE_YAML=/opt/home-assistant-voice-sun.yaml

# This host as the device sees it (the device fetches response audio over HTTP from here).
RTBRIDGE_HTTP_HOST=192.168.68.79
RTBRIDGE_HTTP_PORT=8766

# Session limits (seconds)
RTBRIDGE_IDLE_TIMEOUT=25
RTBRIDGE_MAX_SESSION=600
RTBRIDGE_GREETING=1
# RTBRIDGE_INSTRUCTIONS=...   # override the agent persona
