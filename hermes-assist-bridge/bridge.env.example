HERMES_ASSIST_HOST=0.0.0.0  # bind addr (e.g. your tailscale IP, or 0.0.0.0)
HERMES_ASSIST_PORT=8765
HERMES_ASSIST_KEY_FILE=/etc/hermes-assist-bridge/api.key
HERMES_ENV_FILE=/root/.hermes/.env
HERMES_BIN=/usr/local/bin/hermes
HERMES_ASSIST_TIMEOUT=120
HERMES_ASSIST_MAX_PROMPT_CHARS=6000
HERMES_ASSIST_MAX_HISTORY_MESSAGES=8
HERMES_ASSIST_MAX_TURNS=20
HERMES_ASSIST_REASONING=low
HERMES_ASSIST_TOOLSETS=homeassistant,memory,session_search,web,wolt,cronjob,browser,terminal,skills,messaging
HERMES_ASSIST_MODEL=gpt-5.4-mini
HERMES_ASSIST_USE_DIRECT_AGENT=1
HERMES_REPO=/usr/local/lib/hermes-agent
HERMES_PLATFORM=homeassistant
HERMES_ASSIST_SESSION_RESET_S=300
HERMES_ASSIST_INJECT_SKILLS=
HERMES_ASSIST_CLICK_MEDIA=/local/double-click-computer-mouse.wav
HERMES_ASSIST_TOOL_CLICK=1
HERMES_ASSIST_CLICK_MIN_INTERVAL_S=1.0
